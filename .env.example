# Server-owned model settings. This file is an example, not loaded automatically.
# Inject variables with your service manager or shell environment.
FABFLOW_AGENT_BACKEND=openai_agents
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FABFLOW_MODEL=your-vision-capable-model
FABFLOW_MODEL_API=responses
FABFLOW_MODEL_STORE=false

# Per agent execution. Reading completeness review is a separate bounded run.
FABFLOW_MAX_RUNTIME_SECONDS=600
FABFLOW_MAX_REQUESTS=12
FABFLOW_MAX_TURNS=12
FABFLOW_MAX_TOTAL_TOKENS=100000
FABFLOW_MAX_OUTPUT_TOKENS=12000
FABFLOW_MAX_TOOL_CALLS=64
FABFLOW_MAX_INPUT_BYTES=2097152
FABFLOW_MAX_OUTPUT_BYTES=1048576
FABFLOW_MAX_TOOL_OUTPUT_BYTES=33554432
FABFLOW_MAX_TOTAL_TOOL_BYTES=67108864
