{
  "name": "@haoyunlai/dsh-engineering-demo",
  "version": "0.1.0",
  "private": true,
  "description": "DSH sidebar entry and embedded shell for the Haoyunlai engineering mock demo",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
